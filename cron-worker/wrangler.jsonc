{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remoru-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // この worker は Cron Trigger でしか起きない。fetch のハンドラを持たない
  // ので公開 URL は 500 を返すだけだが、要らない入口は開けておかない。
  "workers_dev": false,
  "preview_urls": false,

  // 毎時0分に起きて、その時刻に通知すべき利用者を探す（design.md D3）。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // 本体アプリと同じデータベース。cron はここを直接読み、自分で送る。
  // 本体への HTTP 呼び出しは行わない（design.md D1）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remoru-db",
      "database_id": "5c1baf13-12a8-4e74-ad65-34a93d13a75f"
    }
  ],

  // staging（design.md D1）。通知の変更を実機で確かめる場所が要るので、cron も
  // staging を動かす。送る相手は **staging の D1 にいる購読者だけ**なので、
  // 本番の利用者には届かない。
  //
  // **バインディングは継承されない。** `d1_databases` をここに書き忘れると
  // 毎時起きては DB 無しで落ちる worker になる。`triggers` も明示する
  // （継承される側だが、staging の cron を止めたいときの触り先をここにする）。
  //
  // 本番と同じ `database_id` になっていないことは
  // `scripts/harness/staging-isolation.test.ts` が見ている（design.md D3）。
  "env": {
    "staging": {
      "name": "remoru-cron-staging",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remoru-db-staging",
          "database_id": "afc356ae-56bf-4f52-9777-288151a26768"
        }
      ]
    }
  }
}
