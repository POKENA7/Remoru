{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remoru-cron",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remoru-db",
      "database_id": "5c1baf13-12a8-4e74-ad65-34a93d13a75f",
      "migrations_dir": "../remoru/drizzle/migrations"
    }
  ],
  "vars": {
    "INTERNAL_API_URL": "https://remoru-web.<your-subdomain>.workers.dev"
  }
}
