# このファイルをコピーして .env.local を作る。
# .env.local は .gitignore で除外されている。実際の鍵をここに書かないこと。
#
# 値は Clerk のダッシュボード（https://dashboard.clerk.com）の API Keys から取得する。
# `clerk init` を実行すると .env.local に自動で書き込まれる。

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# 本番（Cloudflare Workers）ではこのファイルは使われない。
# `npx wrangler secret put CLERK_SECRET_KEY` でシークレットストアに登録する。
# 公開鍵はクライアントに出るので wrangler.jsonc の vars に置いてよい。

# 通知（Web Push）の VAPID 鍵。
# 生成: npx web-push generate-vapid-keys
#
# 本体アプリが要るのは公開鍵だけ（購読を作るときにブラウザへ渡す）。
# 秘密鍵は cron worker 側だけに置く。
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 本番では両方の worker に `npx wrangler secret put` で登録する。
# **片方だけだと購読はできるが届かない**（手順は docs/deploy.md）。

# 問答の生成に使う Anthropic の API キー。
# console.anthropic.com で発行する。Claude Code の Pro プランとは別勘定で、
# 使った分だけ課金される。
#
# 無くてもアプリは壊れない。生成が起きず、メモが「未作成」のまま残るだけ。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
