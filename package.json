{
  "name": "remoru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply remoru-db --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run test && npm run typecheck"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": "npm:tsx@^4",
    "@esbuild-kit/esm-loader": "npm:tsx@^4"
  }
}
